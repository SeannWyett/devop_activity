
APP_NAME="Laravel Request System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_request_container_db
DB_USERNAME=laravel_app
DB_PASSWORD=replace_with_a_local_secret

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
