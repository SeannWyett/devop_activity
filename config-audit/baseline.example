# Declarative baseline for the STAGING release (nonsecret values only).
# Format: KEY=value, one per line. Lines starting with # are ignored.
# Read by config-audit/audit.sh (inside the container) and config-audit/run-audit.ps1 (host).
# Never put passwords, keys or tokens in this file.
# The production baseline is baseline.production.example (only APP_ENV and the URL rules differ).

# Approved environment label and debug setting (compared with the EFFECTIVE Laravel config)
APP_ENV=staging
APP_DEBUG=false

# Public URL must be https (Render terminates TLS; http would break cookies and generated links)
APP_URL_SCHEME=https

# Web server document root: must be Laravel's public/ directory
DOCUMENT_ROOT=/var/www/html/public

# Paths the service account must be able to write, relative to the app root.
# They must NOT be world-writable.
WRITABLE_PATHS=storage bootstrap/cache

# Identity the container runs as (never root)
SERVICE_USER=www-data

# Database: Supabase (Postgres) over TLS, and never a superuser/owner account.
DB_CONNECTION=pgsql
DB_SSLMODE=require
# Regex of runtime usernames that are NOT allowed. Supabase pooler names look like
# "<role>.<project-ref>", so "postgres.abcd1234" is the superuser through the pooler.
DB_FORBIDDEN_USER_REGEX=^(root|postgres|supabase_admin)(\.|$)

# Live URL controls checked by run-audit.ps1 -Url
MIN_CERT_DAYS=7
