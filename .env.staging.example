# Copy to .env.staging (gitignored). NEVER commit .env.staging.
#
# This file mirrors what you enter as environment variables on the Render STAGING service.
# Locally it is used by scripts/artisan-remote.ps1 (migrations, seeding) and
# config-audit/run-audit.ps1 (configuration audit in a throwaway container).
# Docker --env-file takes values literally: do not wrap values in quotes.
#
# APP_KEY: generate ONCE and keep it for every release. It must differ from dev and production.
#   Print a new key without writing it anywhere:
#     docker compose exec app php artisan key:generate --show
# Do not put APP_VERSION or GIT_SHA here: they are baked into the image.

APP_NAME=Laravel Request System (Staging)
APP_ENV=staging
APP_DEBUG=false
APP_KEY=
APP_URL=https://YOUR-STAGING-SERVICE.onrender.com
LOG_CHANNEL=stderr
LOG_LEVEL=info

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Supabase (Postgres). Use the Connect panel of the STAGING project; session pooler recommended.
# Username looks like  laravel_app.<project-ref>  (a restricted role, never postgres).
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
