# Copy to .env.staging (gitignored) and fill in. NEVER commit .env.staging.
#
# Generate the APP_KEY ONCE and keep it for every release. It must differ from
# your dev and container keys. Print a new key without writing it anywhere:
#   docker compose exec app php artisan key:generate --show
# Do not put APP_VERSION or GIT_SHA here: they are baked into the image.
# Avoid the $ character in passwords (Compose treats it as interpolation).

APP_NAME="Laravel Request System (Staging)"
APP_KEY=
APP_URL=http://127.0.0.1:8081
LOG_LEVEL=info

DB_DATABASE=laravel_request_staging_db
DB_USERNAME=laravel_app
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
