# Copy to .env.staging.db (gitignored). NEVER commit .env.staging.db.
#
# Holds ONLY the MySQL root password. It is used by the db service and is
# deliberately kept out of .env.staging so the app container never receives it
# (least privilege - the app runs with the restricted laravel_app account).
# Avoid the $ character in passwords.

DB_ROOT_PASSWORD=
